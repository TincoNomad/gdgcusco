---
import Container from '../ui/Container.astro';
import { siteConfig } from '../../data/site.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" aria-labelledby="hero-title">
  <!--div class="hero__background" aria-hidden="true">
    <img src="https://placehold.co/1200x800/d8f0fe/4285f4?text=Hero+Background" alt="" />
  </div-->

  <Container as="div">
    <div class="hero__content">
      <span class="hero__eyebrow">{siteConfig.tagline}</span>
      <h1 id="hero-title" class="hero__title">{siteConfig.name}</h1>

      <!--div class="hero__sponsor">
        <span>By</span>
        <img src="https://placehold.co/200x50/ffffff/4285f4?text=Interledger" alt="Patrocinador principal" width="120" height="30" />
      </div-->

      <p class="hero__subtitle">
        Tecnología que se amplifica<br />desde Cusco
      </p>

      <p class="hero__description">{siteConfig.description}</p>

      <div class="hero__actions">
        <div class="hero__actions-row">
          <a href="#" class="hero__actions-primary">Entradas proximamente</a>
          <a href="#become-sponsor" class="hero__actions-secondary">Patrocinar</a>
        </div>
        <div class="hero__actions-row">
          <a href="https://forms.gle/HdJMrSzBQYazRJiAA" target="blank" class="hero__actions-tertiary">Dar una charla</a>
        </div>
      </div>
    </div>
  </Container>

  <div class="hero__decorations" aria-hidden="true">
    <div class="hero__quadrant">
      <img src={`${base}/images/amarillo.webp`} alt="" loading="lazy" />
    </div>
    <div class="hero__quadrant">
      <img src={`${base}/images/azul.webp`} alt="" loading="lazy" />
    </div>
    <div class="hero__quadrant">
      <img src={`${base}/images/rojo.webp`} alt="" loading="lazy" />
    </div>
    <div class="hero__quadrant hero__quadrant--green">
      <img src={`${base}/images/verde.webp`} alt="" loading="lazy" />
    </div>
  </div>

</section>

<style>
	.hero {
		position: relative;
		z-index: 0;
		min-height: calc(100vh - var(--header-height));
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-block: var(--space-16);
		overflow: clip;
		background: var(--color-section-alt);
	}

	.hero__background {
		position: absolute;
		inset: 0;
		opacity: 0.15;
		pointer-events: none;
	}

	.hero__background img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero > .container {
		position: relative;
		z-index: 1;
	}

	.hero__content {
		max-width: 50rem;
		margin-inline: auto;
		margin-block: auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.hero__decorations {
		--quadrant-size: clamp(16rem, 18vw, 18rem);
		--quadrant-padding: clamp(1rem, 2vw, 1.875rem);
		--decor-gap-y: clamp(50px, 7vh, 90px);
		--decor-gap-x: clamp(80px, 13vw, 290px);

		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: -1;
	}

	.hero__quadrant {
		position: absolute;
		width: var(--quadrant-size);
		height: var(--quadrant-size);
		padding: var(--quadrant-padding);
		overflow: hidden;
		box-sizing: border-box;
	}

	.hero__quadrant:nth-child(1) {
		top: calc(var(--header-height) + var(--decor-gap-y));
		left: var(--decor-gap-x);
	}

	.hero__quadrant:nth-child(2) {
		top: calc(var(--header-height) + var(--decor-gap-y));
		right: var(--decor-gap-x);
		transform: rotate(30deg);
	}

	.hero__quadrant:nth-child(3) {
		bottom: var(--decor-gap-y);
		left: var(--decor-gap-x);
		transform: rotate(-45deg);
	}

	.hero__quadrant:nth-child(4) {
		bottom: var(--decor-gap-y);
		right: var(--decor-gap-x);
	}

	.hero__quadrant img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transform-origin: center center;
		animation: bounce-1 4.5s ease-in-out infinite;
	}

	.hero__quadrant:nth-child(2) img {
		animation-name: bounce-2;
		animation-duration: 5s;
		animation-delay: -1s;
	}

	.hero__quadrant:nth-child(3) img {
		animation-name: bounce-3;
		animation-duration: 4s;
		animation-delay: -2s;
	}

	.hero__quadrant:nth-child(4) img {
		animation-name: bounce-4;
		animation-duration: 5.5s;
		animation-delay: -0.5s;
	}

	@keyframes bounce-1 {
		0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
		20% { transform: translate(18px, -22px) rotate(2deg) scale(1.02); }
		40% { transform: translate(-15px, 12px) rotate(-2deg) scale(0.98); }
		60% { transform: translate(12px, 18px) rotate(1deg) scale(1.01); }
		80% { transform: translate(-10px, -12px) rotate(-1deg) scale(0.99); }
	}

	@keyframes bounce-2 {
		0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
		25% { transform: translate(-20px, -15px) rotate(-2deg) scale(1.02); }
		50% { transform: translate(15px, 20px) rotate(2deg) scale(0.98); }
		75% { transform: translate(-12px, -18px) rotate(-1deg) scale(1.01); }
	}

	@keyframes bounce-3 {
		0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
		20% { transform: translate(15px, 18px) rotate(1deg) scale(0.98); }
		40% { transform: translate(-18px, -12px) rotate(-2deg) scale(1.02); }
		60% { transform: translate(20px, -20px) rotate(1deg) scale(1.02); }
		80% { transform: translate(-10px, 15px) rotate(-1deg) scale(0.99); }
	}

	@keyframes bounce-4 {
		0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
		25% { transform: translate(-12px, 20px) rotate(-1deg) scale(1.01); }
		50% { transform: translate(18px, -15px) rotate(2deg) scale(0.98); }
		75% { transform: translate(-15px, -10px) rotate(-1deg) scale(1.01); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__quadrant img {
			animation: none;
		}
	}

	.hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.hero__title {
		font-size: clamp(2.75rem, 8vw, 5rem);
		font-weight: 900;
		line-height: 1.05;
		margin: 0;
		color: var(--color-text);
	}

	.hero__sponsor {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-inline: auto;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-secondary);
	}

	.hero__sponsor img {
		height: 1.75rem;
		width: auto;
	}

	.hero__subtitle {
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		font-weight: 400;
		margin: 0;
		color: var(--color-text-secondary);
	}

	.hero__subtitle br {
		display: none;
	}

	.hero__description {
		font-size: 1.125rem;
		color: var(--color-text);
		max-width: 32rem;
		margin-inline: auto;
	}

	.hero__actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		justify-content: center;
		align-items: center;
		margin-top: var(--space-4);
	}

	.hero__actions-row {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
		justify-content: center;
	}

	.hero__actions a {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-3) var(--space-6);
		border-radius: var(--radius-full);
		font-weight: 600;
		border: 1px solid transparent;
		transition: transform var(--duration-base) var(--ease-default),
			background-color var(--duration-base) var(--ease-default),
			border-color var(--duration-base) var(--ease-default),
			color var(--duration-base) var(--ease-default),
			filter var(--duration-base) var(--ease-default);
	}

	.hero__actions a:hover {
		transform: translateY(-2px);
	}

	.hero__actions-primary {
		background: var(--gradient-blue);
		color: var(--color-text-on-primary);
	}

	.hero__actions-primary:hover {
		filter: brightness(0.9);
	}

	.hero__actions-secondary,
	.hero__actions-tertiary {
		background: transparent;
		color: var(--color-primary);
	}

	.hero__actions-secondary::before,
	.hero__actions-tertiary::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius-full);
		padding: 1px;
		background: var(--gradient-blue);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	.hero__actions-secondary:hover,
	.hero__actions-tertiary:hover {
		background: var(--gradient-blue);
		color: var(--color-text-on-primary);
	}

	@media (max-width: 1199px) {
		.hero__decorations {
			--decor-gap-x: 80px;
		}
	}

	@media (max-width: 767px) {
		.hero__decorations {
			--quadrant-size: 200px;
			--quadrant-padding: 24px;
			--decor-gap-x: 0px;
			--decor-gap-y: 0px;
		}

		.hero__quadrant {
			border-radius: var(--radius-lg);
		}

		.hero__quadrant:nth-child(2) {
			display: none;
		}

		.hero__quadrant:nth-child(1) {
			top: var(--header-height);
			left: 0;
			transform: translate(-50%, 0%);
		}

		.hero__quadrant:nth-child(3) {
			bottom: 0;
			left: 0;
			transform: translate(-50%, 0%);
		}

		.hero__quadrant:nth-child(4) {
			top: 50%;
			right: 0;
			transform: translate(50%, -50%);
		}
	}

	@media (min-width: 768px) {
		.hero__subtitle br {
			display: block;
		}

		.hero__actions-row {
			flex-direction: row;
		}
	}
</style>

---
import Container from '../ui/Container.astro';

const agendaColors = [
  { a: '#FC4240', b: '#FA5473' },
  { a: '#3186FD', b: '#919FFE' },
  { a: '#2BB055', b: '#61C6DE' },
  { a: '#FFCC01', b: '#FCEF52' },
];

const dayOne = [
  { time: '9:00 – 9:15', title: 'Inauguración del evento', type: 'session' },
  { time: '9:15 – 9:45', title: 'WebMCP in action', speaker: 'Vanessa Aristizábal', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '9:45 – 10:15', title: 'Agentic Engineering en Flutter', speaker: 'Luis Enrique Pinedo', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '10:15 – 10:45', title: 'TBD', speaker: 'Bruno Aybar', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '10:45 – 11:15', title: 'Agentic Development in practice', speaker: 'Adrián Catalán', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '10:45 – 11:15', title: '¿Puede Hugging Face manipular a Antigravity?', speaker: 'David Alonso Quispe', type: 'talk', kind: 'Taller', place: 'Aula' },
  { time: '11:15 – 11:30', title: 'Break', type: 'break' },
  { time: '11:30 – 12:00', title: 'Impulsa tu carrera con IA y comunidad', speaker: 'Ximena Cruz', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '11:30 – 12:00', title: 'Más allá del código: diseño conversacional para agentes de IA', speaker: 'Luis Ángel Quispe Navarro', type: 'talk', kind: 'Taller', place: 'Aula' },
  { time: '12:00 – 13:00', title: 'Software en un mundo de IA?', speaker: 'Andrés Chávez', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '13:00 – 14:30', title: 'Almuerzo', type: 'break' },
  { time: '14:30 – 15:00', title: '¡Dale a tu cuerpo alegría ♫ … robot?! — AGY en el mundo físico', speaker: 'Hansy', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '14:30 – 15:00', title: 'De Cusco a la Nube de Datos: Un salto hacia nuevas oportunidades', speaker: 'Ian Logan Will Quispe Ventura', type: 'talk', kind: 'Taller', place: 'Aula' },
  { time: '15:00 – 15:30', title: 'Building and Deploying with Google ADK and Gemini', speaker: 'Carlos Alarcón', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '15:30 – 16:00', title: 'Como construir tu software factory con agente de IA', speaker: 'Jonathan Nolasco', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '16:00 – 16:15', title: 'Break', type: 'break' },
  { time: '16:15 – 16:45', title: 'Data & Analytics en la era multi-cloud: SQL Server y Google BigQuery', speaker: 'Renzo Roca', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '16:45 – 17:15', title: 'La ilusión de velocidad.', speaker: 'Noe Branagan', type: 'talk', kind: 'Charla', place: 'Auditorio' },
  { time: '17:15 – 17:45', title: 'Conversatorio', type: 'session' },
  { time: '17:45 – 18:15', title: 'Cierre', type: 'session' },
];

const dayTwo = [
  { time: '8:00 – 9:00', title: 'Bienvenida', type: 'session' },
  { time: '9:00 – 9:20', title: 'Cómo una charla en este escenario me cambió la vida', speaker: 'Erasmo Hernández', type: 'talk' },
  { time: '9:25 – 9:45', title: '¿Agentes para Pagos? Sí, con Open Payments es Posible.', speaker: 'Marian Villa', type: 'talk' },
  { time: '9:50 – 10:20', title: 'Snack', type: 'break' },
  { time: '12:00 – 13:30', title: 'Almuerzo', type: 'break' },
  { time: '17:25', title: 'Clausura', type: 'session' },
];

// Agrupa items consecutivos que comparten horario en una sola fila.
// Fila con más de un item = sesiones paralelas a la misma hora.
const rows = dayOne.reduce((acc, item, index) => {
  const colorIndex = item.colorIndex ?? index % agendaColors.length;
  const last = acc[acc.length - 1];
  if (last && last[0].time === item.time) {
    last.push({ ...item, colorIndex });
  } else {
    acc.push([{ ...item, colorIndex }]);
  }
  return acc;
}, []);
---

<section id="agenda" class="agenda" aria-labelledby="agenda-title">
  <Container as="div">
    <h2 id="agenda-title" class="agenda__title">Agenda</h2>

    <!--div class="agenda__tabs" role="tablist" aria-label="Días de la agenda">
  <button type="button" role="tab" aria-selected="true" id="tab-day-1" aria-controls="panel-day-1">
  Día 1
  <span>14 Ago</span>
        </button>
      <button type="button" role="tab" aria-selected="false" id="tab-day-2" aria-controls="panel-day-2">
        Día 2
        <span>15 Ago</span>
      </button>
    </div-->

    <div id="panel-day-1" role="tabpanel" aria-labelledby="tab-day-1" class="agenda__panel">
      <ol class="agenda__list">
        {
          rows.map((row) =>
            row.length > 1 ? (
              <li class="agenda__row agenda__row--split">
                {row.map((item) => (
                  <div class={`agenda__item agenda__item--${item.type} agenda__item--color-${item.colorIndex}`}>
                    {item.kind && <span class="agenda__kind">{item.kind}</span>}
                    <div class="agenda__meta">
                      <time>{item.time}</time>
                      {item.place && <span class="agenda__place">{item.place}</span>}
                    </div>
                    <div>
                      <h3>{item.title}</h3>
                      {item.speaker && <p>{item.speaker}</p>}
                    </div>
                  </div>
                ))}
              </li>
            ) : (
              <li class={`agenda__item agenda__item--${row[0].type} agenda__item--color-${row[0].colorIndex}`}>
                {row[0].kind && <span class="agenda__kind">{row[0].kind}</span>}
                <div class="agenda__meta">
                  <time>{row[0].time}</time>
                  {row[0].place && <span class="agenda__place">{row[0].place}</span>}
                </div>
                <div>
                  <h3>{row[0].title}</h3>
                  {row[0].speaker && <p>{row[0].speaker}</p>}
                </div>
              </li>
            )
          )
        }
      </ol>
    </div>

    <div id="panel-day-2" role="tabpanel" aria-labelledby="tab-day-2" class="agenda__panel" hidden>
      <ol class="agenda__list">
        {
          dayTwo.map((item, index) => (
            <li class={`agenda__item agenda__item--${item.type} agenda__item--color-${index % agendaColors.length}`}>
              <time>{item.time}</time>
              <div>
                <h3>{item.title}</h3>
                {item.speaker && <p>{item.speaker}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<style>
	.agenda {
		padding-block: var(--space-20);
		background: var(--color-section-alt);
	}

	.agenda__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--space-10);
		color: var(--color-text);
	}

	.agenda__tabs {
		display: flex;
		justify-content: center;
		gap: var(--space-2);
		padding: var(--space-2);
		margin-bottom: var(--space-10);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
		width: fit-content;
		margin-inline: auto;
	}

	.agenda__tabs button {
		padding: var(--space-2) var(--space-6);
		border: 0;
		border-radius: var(--radius-full);
		background: transparent;
		font-weight: 600;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: background-color var(--duration-base) var(--ease-default),
			color var(--duration-base) var(--ease-default);
	}

	.agenda__tabs button[aria-selected='true'] {
		background: var(--color-primary);
		color: var(--color-text-on-primary);
	}

	.agenda__tabs button span {
		display: block;
		font-size: 0.75rem;
		font-weight: 400;
		opacity: 0.8;
	}

	.agenda__list {
		position: relative;
		max-width: 50rem;
		margin-inline: auto;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.agenda__list::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 1rem;
		width: 2px;
		background: var(--color-border);
	}

	.agenda__item {
		position: relative;
		display: grid;
		/* 6.5rem en vez de 5rem: "10:15 – 10:45" mide ~91px y con
		   5rem se partía en dos líneas (era lo que se veía "en columna") */
		grid-template-columns: 6.5rem 1fr;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		margin-left: 2rem;
		border: 2px solid;
		border-radius: var(--radius-lg);
	}

	.agenda__item::before {
		content: '';
		position: absolute;
		left: -1.5rem;
		top: 50%;
		transform: translateY(-50%);
		width: 0.75rem;
		height: 0.75rem;
		border-radius: var(--radius-full);
		border: 2px solid var(--color-surface);
	}

	.agenda__item time {
		font-weight: 700;
		font-size: 0.875rem;
		white-space: nowrap;
	}

	/* Hora + badge de sala: viven en la primera columna del grid.
	   El badge queda pegado debajo del horario. */
	.agenda__meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
	}

	.agenda__item h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.agenda__item p {
		margin: var(--space-1) 0 0;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	.agenda__item--color-0 {
		background: var(--color-red-pastel);
		border-color: #FC4240;
	}

	.agenda__item--color-1 {
		background: var(--color-blue-pastel);
		border-color: #3186FD;
	}

	.agenda__item--color-2 {
		background: var(--color-green-pastel);
		border-color: #2BB055;
	}

	.agenda__item--color-3 {
		background: var(--color-yellow-pastel);
		border-color: #FFCC01;
	}

	.agenda__item--color-0::before {
		background: #FC4240;
	}

	.agenda__item--color-1::before {
		background: #3186FD;
	}

	.agenda__item--color-2::before {
		background: #2BB055;
	}

	.agenda__item--color-3::before {
		background: #FFCC01;
	}

	.agenda__item--color-0 time {
		color: #FC4240;
	}

	.agenda__item--color-1 time {
		color: #3186FD;
	}

	.agenda__item--color-2 time {
		color: #2BB055;
	}

	.agenda__item--color-3 time {
		color: #FFCC01;
	}

	/* Línea superior con el tipo de sesión (Charla / Taller).
	   Abarga las dos columnas del grid y se centra. */
	.agenda__kind {
		grid-column: 1 / -1;
		text-align: center;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	/* Badge de sala (Auditorio / Aula) — se muestra solo en los items
	   que traen `place` en los datos. */
	.agenda__place {
		display: inline-block;
		padding: 2px 8px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	/* Fila con sesiones paralelas: wrapper sin estilos visuales,
	   los boxes adentro sí conservan fondo/borde/redondeado. */
	.agenda__row--split {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	/* Mobile: los boxes apilados conservan su propio punto, como
	   cualquier otro item. El punto compartido es solo de desktop. */
	.agenda__row--split::after {
		display: none;
	}

	.agenda__item--break,
	.agenda__item--session {
		justify-content: center;
		text-align: center;
		margin-left: 0;
		grid-template-columns: 1fr;
	}

	/* Los breaks no traen badge, pero `.agenda__meta` fija
	   align-items: flex-start y rompería el centrado del horario. */
	.agenda__item--break .agenda__meta,
	.agenda__item--session .agenda__meta {
		align-items: center;
	}

	.agenda__item--break::before,
	.agenda__item--session::before {
		display: none;
	}

	.agenda__item--break h3,
	.agenda__item--session h3 {
		font-size: 1.125rem;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.agenda__list::before {
			left: 50%;
			transform: translateX(-50%);
		}

		.agenda__item {
			width: calc(50% - var(--space-6));
			margin-left: 0;
		}

		.agenda__item:nth-child(odd) {
			margin-right: auto;
		}

		.agenda__item:nth-child(even) {
			margin-left: auto;
		}

		.agenda__item::before {
			left: auto;
			right: -1.875rem;
		}

		.agenda__item:nth-child(even)::before {
			right: auto;
			left: -1.875rem;
		}

		.agenda__item--break,
		.agenda__item--session {
			width: 100%;
			max-width: 30rem;
			margin-inline: auto;
		}

		/* La fila ocupa 100% y cada box usa el mismo largo que un item
		   normal: calc(50% - space-6). space-between mete el sobrante
		   en el hueco central, que queda centrado sobre la línea. */
		.agenda__row--split {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			width: 100%;
			gap: var(--space-4);
		}

		.agenda__row--split > .agenda__item {
			width: calc(50% - var(--space-6));
			flex: 0 1 auto;
			margin-left: 0;
			margin-right: 0;
		}

		/* Un solo punto de timeline centrado en la fila: los dos
		   puntos internos se ocultan porque caerían en el mismo
		   sitio (mismo left: 50%) y con alturas distintas. */
		.agenda__row--split::after {
			display: block;
			content: '';
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			width: 0.75rem;
			height: 0.75rem;
			border-radius: var(--radius-full);
			border: 2px solid var(--color-surface);
			background: var(--color-primary);
		}

		.agenda__row--split > .agenda__item::before {
			display: none;
		}
	}
</style>

<script>
  const tabs = document.querySelectorAll('[role="tab"]');
  const panels = document.querySelectorAll('[role="tabpanel"]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('aria-controls');

      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');

      panels.forEach((panel) => {
        const isTarget = panel.id === targetId;
        panel.toggleAttribute('hidden', !isTarget);
      });
    });
  });
</script>

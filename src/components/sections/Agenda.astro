---
import Container from '../ui/Container.astro';

const agendaColors = [
  { a: '#FC4240', b: '#FA5473' },
  { a: '#3186FD', b: '#919FFE' },
  { a: '#2BB055', b: '#61C6DE' },
  { a: '#FFCC01', b: '#FCEF52' },
];

const dayOne = [
  { time: '9:00 – 9:15', title: 'Bienvenida', type: 'session' },
  { time: '9:15 – 9:45', title: 'Charla 1', type: 'talk' },
  { time: '9:45 – 10:15', title: 'Charla 1', type: 'talk' },
  { time: '10:15 – 10:45', title: 'Charla 1', type: 'talk' },
  { time: '10:45 – 11:15', title: 'Break', type: 'break' },
  { time: '11:15 – 11:45', title: 'Charla 1', type: 'talk' },
  { time: '11:45 – 12:15', title: 'Charla 1', type: 'talk' },
  { time: '12:15 – 1:30', title: 'Almuerzo', type: 'break' },
  { time: '1:30 – 2:15', title: 'Charla 1', type: 'talk' },
  { time: '2:15 – 2:45', title: 'Charla 1', type: 'talk' },
  { time: '2:45 – 3:30', title: 'Conversatorio', type: 'session' },
  { time: '3:30 – 4:00', title: 'Charla 1', type: 'talk' },
  { time: '4:00 – 4:15', title: 'Cierre', type: 'session' },
];

const dayTwo = [
  { time: '8:00 – 9:00', title: 'Bienvenida', type: 'session' },
  { time: '9:00 – 9:20', title: 'Cómo una charla en este escenario me cambió la vida', speaker: 'Erasmo Hernández', type: 'talk' },
  { time: '9:25 – 9:45', title: '¿Agentes para Pagos? Sí, con Open Payments es Posible.', speaker: 'Marian Villa', type: 'talk' },
  { time: '9:50 – 10:20', title: 'Snack', type: 'break' },
  { time: '12:00 – 13:30', title: 'Almuerzo', type: 'break' },
  { time: '17:25', title: 'Clausura', type: 'session' },
];
---

<section id="agenda" class="agenda" aria-labelledby="agenda-title">
  <Container as="div">
    <h2 id="agenda-title" class="agenda__title">Agenda</h2>

    <div class="agenda__tabs" role="tablist" aria-label="Días de la agenda">
      <!--button type="button" role="tab" aria-selected="true" id="tab-day-1" aria-controls="panel-day-1"-->
        Día 1
        <span>14 Ago</span>
        <!--/button-->
      <!--button type="button" role="tab" aria-selected="false" id="tab-day-2" aria-controls="panel-day-2">
        Día 2
        <span>15 Ago</span>
      </button-->
    </div>

    <div id="panel-day-1" role="tabpanel" aria-labelledby="tab-day-1" class="agenda__panel">
      <ol class="agenda__list">
        {
          dayOne.map((item, index) => (
            <li class={`agenda__item agenda__item--${item.type} agenda__item--color-${index % agendaColors.length}`}>
              <time>{item.time}</time>
              <div>
                <h3>{item.title}</h3>
                {item.speaker && <p>{item.speaker}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div id="panel-day-2" role="tabpanel" aria-labelledby="tab-day-2" class="agenda__panel" hidden>
      <ol class="agenda__list">
        {
          dayTwo.map((item, index) => (
            <li class={`agenda__item agenda__item--${item.type} agenda__item--color-${index % agendaColors.length}`}>
              <time>{item.time}</time>
              <div>
                <h3>{item.title}</h3>
                {item.speaker && <p>{item.speaker}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<style>
	.agenda {
		padding-block: var(--space-20);
		background: var(--color-section-alt);
	}

	.agenda__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--space-10);
		color: var(--color-text);
	}

	.agenda__tabs {
		display: flex;
		justify-content: center;
		gap: var(--space-2);
		padding: var(--space-2);
		margin-bottom: var(--space-10);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
		width: fit-content;
		margin-inline: auto;
	}

	.agenda__tabs button {
		padding: var(--space-2) var(--space-6);
		border: 0;
		border-radius: var(--radius-full);
		background: transparent;
		font-weight: 600;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: background-color var(--duration-base) var(--ease-default),
			color var(--duration-base) var(--ease-default);
	}

	.agenda__tabs button[aria-selected='true'] {
		background: var(--color-primary);
		color: var(--color-text-on-primary);
	}

	.agenda__tabs button span {
		display: block;
		font-size: 0.75rem;
		font-weight: 400;
		opacity: 0.8;
	}

	.agenda__list {
		position: relative;
		max-width: 50rem;
		margin-inline: auto;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.agenda__list::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 1rem;
		width: 2px;
		background: var(--color-border);
	}

	.agenda__item {
		position: relative;
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		margin-left: 2rem;
		border: 2px solid;
		border-radius: var(--radius-lg);
	}

	.agenda__item::before {
		content: '';
		position: absolute;
		left: -1.5rem;
		top: 50%;
		transform: translateY(-50%);
		width: 0.75rem;
		height: 0.75rem;
		border-radius: var(--radius-full);
		border: 2px solid var(--color-surface);
	}

	.agenda__item time {
		font-weight: 700;
		font-size: 0.875rem;
	}

	.agenda__item h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.agenda__item p {
		margin: var(--space-1) 0 0;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	.agenda__item--color-0 {
		background: var(--color-red-pastel);
		border-color: #FC4240;
	}

	.agenda__item--color-1 {
		background: var(--color-blue-pastel);
		border-color: #3186FD;
	}

	.agenda__item--color-2 {
		background: var(--color-green-pastel);
		border-color: #2BB055;
	}

	.agenda__item--color-3 {
		background: var(--color-yellow-pastel);
		border-color: #FFCC01;
	}

	.agenda__item--color-0::before {
		background: #FC4240;
	}

	.agenda__item--color-1::before {
		background: #3186FD;
	}

	.agenda__item--color-2::before {
		background: #2BB055;
	}

	.agenda__item--color-3::before {
		background: #FFCC01;
	}

	.agenda__item--color-0 time {
		color: #FC4240;
	}

	.agenda__item--color-1 time {
		color: #3186FD;
	}

	.agenda__item--color-2 time {
		color: #2BB055;
	}

	.agenda__item--color-3 time {
		color: #FFCC01;
	}

	.agenda__item--break,
	.agenda__item--session {
		justify-content: center;
		text-align: center;
		margin-left: 0;
		grid-template-columns: 1fr;
	}

	.agenda__item--break::before,
	.agenda__item--session::before {
		display: none;
	}

	.agenda__item--break h3,
	.agenda__item--session h3 {
		font-size: 1.125rem;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.agenda__list::before {
			left: 50%;
			transform: translateX(-50%);
		}

		.agenda__item {
			width: calc(50% - var(--space-6));
			margin-left: 0;
		}

		.agenda__item:nth-child(odd) {
			margin-right: auto;
		}

		.agenda__item:nth-child(even) {
			margin-left: auto;
		}

		.agenda__item::before {
			left: auto;
			right: -1.875rem;
		}

		.agenda__item:nth-child(even)::before {
			right: auto;
			left: -1.875rem;
		}

		.agenda__item--break,
		.agenda__item--session {
			width: 100%;
			max-width: 30rem;
			margin-inline: auto !important;
		}
	}
</style>

<script>
  const tabs = document.querySelectorAll('[role="tab"]');
  const panels = document.querySelectorAll('[role="tabpanel"]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('aria-controls');

      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');

      panels.forEach((panel) => {
        const isTarget = panel.id === targetId;
        panel.toggleAttribute('hidden', !isTarget);
      });
    });
  });
</script>

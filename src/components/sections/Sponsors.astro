---
import Container from '../ui/Container.astro';
import { sponsors } from '../../data/site.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="sponsors" class="sponsors" aria-labelledby="sponsors-title">
  <Container as="div">
    <h2 id="sponsors-title" class="sponsors__title">Sponsors</h2>

    <ul class="sponsors__grid" role="list">
      {
        sponsors.map((sponsor) => (
          <li role="listitem">
            <a
              href={sponsor.href}
              target="_blank"
              rel="noopener"
              title={sponsor.name}
              class="sponsor-logo"
            >
              <img src={`${base}${sponsor.src}`} alt={`Logo de ${sponsor.name}`} loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
	.sponsors {
		padding-block: var(--space-20);
		background: var(--color-section-alt);
	}

	.sponsors__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--space-10);
		color: var(--color-text);
	}

	.sponsors__grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.sponsors__grid li {
		flex: 0 1 30%;
		min-width: 10rem;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.sponsor-logo {
		width: 100%;
		height: 6rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-3) var(--space-4);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		transition: transform var(--duration-base) var(--ease-default),
			box-shadow var(--duration-base) var(--ease-default),
			border-color var(--duration-base) var(--ease-default);
	}

	.sponsor-logo:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-primary);
	}

	.sponsor-logo img {
		max-width: 100%;
		height: 4rem;
		object-fit: contain;
	}
</style>
